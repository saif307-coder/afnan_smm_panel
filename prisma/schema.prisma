datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model ReelCampaign {
  id                     String   @id @default(cuid())
  reelUrl                String?
  collaborationText      String   @default("Collaboration with cinematic.edits.fx and songs_movies.byte")
  videoDurationSeconds   Int      @default(60)
  views                  Int      @default(100000)
  viewers                Int
  avgWatchTimeSeconds    Int
  follows                Int
  likes                  Int      @default(1500)
  comments               Int      @default(0)
  reposts                Int      @default(15)
  shares                 Int      @default(49)
  saves                  Int      @default(144)
  followersPercentage    Float    @default(0.4)
  nonFollowersPercentage Float    @default(99.6)
  countriesJson          String
  graphDataJson          String
  serviceStatus          String   @default("IDLE")
  updatedAt              DateTime @updatedAt
  createdAt              DateTime @default(now())
}

// ─── Phase 2: Admin Settings ────────────────────────────────────────────────
// Singleton row storing default percentage ratios for metric calculations.
// Only one row should exist (enforced at the application layer).
model AdminSettings {
  id                    String   @id @default(cuid())
  likesPercentage       Float    @default(3.4)
  savesPercentage       Float    @default(2.8)
  commentsPercentage    Float    @default(0.12)
  sharesPercentage      Float    @default(0.95)
  repostsPercentage     Float    @default(0.35)
  followsPercentage     Float    @default(0.025)
  viewersPercentage     Float    @default(67.5)
  avgWatchTimeRatio     Float    @default(0.7)
  CRON_STATUS_SYNC_ACTIVE Boolean @default(true)
  updatedAt             DateTime @updatedAt
  createdAt             DateTime @default(now())
}

// ─── Phase 2: 3rd-Party SMM Providers ───────────────────────────────────────
// Stores credentials for external SMM panel provider APIs.
model SmmProvider {
  id          String           @id @default(cuid())
  name        String
  apiUrl      String
  apiKey      String
  isActive    Boolean          @default(true)
  mappings    ServiceMapping[]
  orders      Order[]
  updatedAt   DateTime         @updatedAt
  createdAt   DateTime         @default(now())
}

// ─── Phase 2: Service Mappings ──────────────────────────────────────────────
// Maps internal metric types (VIEWS, LIKES, etc.) to provider-specific service IDs.
// Each provider can have at most one mapping per metric type.
model ServiceMapping {
  id             String      @id @default(cuid())
  providerId     String
  provider       SmmProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  metricType     String      // e.g. "VIEWS", "LIKES", "SAVES", "COMMENTS", "SHARES", "REPOSTS", "FOLLOWS"
  serviceId      String      // The provider's external service ID
  costPer1000    Float       @default(0)
  minQuantity    Int         @default(0)
  isActive       Boolean     @default(true)
  updatedAt      DateTime    @updatedAt
  createdAt      DateTime    @default(now())

  @@unique([providerId, metricType])
}

// ─── Phase 4: Orders & Dispatch History ─────────────────────────────────────
// Tracks bundled orders, calculated engagement breakdowns, and provider responses.
model Order {
  id                    String       @id @default(cuid())
  targetReelUrl         String?
  baseViews             Int
  percentagesJson       String
  calculatedMetricsJson String?
  likes                 Int          @default(0)
  saves                 Int          @default(0)
  shares                Int          @default(0)
  reposts               Int          @default(0)
  comments              Int          @default(0)
  followers             Int          @default(0)
  totalCost             Float        @default(0)
  status                String       @default("PENDING") // PENDING, PROCESSING, COMPLETED, PARTIAL, FAILED
  providerId            String?
  provider              SmmProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  providerResponsesJson String?      // Detailed JSON log of all external provider API calls & order IDs
  errorMessage          String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
}

